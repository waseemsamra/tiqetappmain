# Tiqets API Configuration
TIQETS_API_KEY=

# Google AI Configuration (Genkit)
GOOGLE_GENAI_API_KEY=your_google_ai_key_here

# Mobile redirect (see mobile/redirect.ts and desktop/redirect.ts)
# Mobile browsers are redirected to the /m mobile page.
# Set to "false" to serve the desktop site to everyone.
MOBILE_REDIRECT_ENABLED=true